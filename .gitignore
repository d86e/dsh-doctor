# Dependencies
node_modules/
.pnpm-store/

# Build output
# We commit `lib/` so that `dsh plugin add <git-url>` does not need to run
# the `prepare` script (which pnpm blocks by default for git-hosted
# dependencies). Every release must run `pnpm run build` before `git push`.
# `*.tsbuildinfo` is still per-developer.
*.tsbuildinfo

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Test artifacts
coverage/
.nyc_output/
*.tgz

# DSH runtime (in case someone runs `dsh plugin` from this dir)
.dsh/

# Environment
.env
.env.local
.env.*.local
